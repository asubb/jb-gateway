# Ports to tunnel (comma-separated list or ranges)
# Examples: 8080, 8080-8085, 8080,9000,3000
PROXY_PORTS=9888,9999

# Enable automatic tunnel monitoring and repair
AUTO_REFRESH=true

# Gateway SSH connection settings
SSH_PORT=1022
SSH_USER=jb-gateway
SSH_HOST=192.168.86.101
SSH_PASSWORD=password

# Proxy destination configuration (optional)
# Format: PORT:DESTINATION,PORT:DESTINATION
# Valid destinations: CONTAINER_LOCALHOST, HOST_NETWORK
# Default: HOST_NETWORK for all ports
#
# Examples:
# - Route port 3000 to container localhost: PROXY_DESTINATIONS=3000:CONTAINER_LOCALHOST
# - Mixed destinations: PROXY_DESTINATIONS=3000:CONTAINER_LOCALHOST,8080:HOST_NETWORK
# - Multiple localhost ports: PROXY_DESTINATIONS=3000:CONTAINER_LOCALHOST,9999:CONTAINER_LOCALHOST
#
# Use CONTAINER_LOCALHOST when your application runs inside the gateway container
# and listens on 127.0.0.1 or localhost
#PROXY_DESTINATIONS=3000:CONTAINER_LOCALHOST,8080:HOST_NETWORK
